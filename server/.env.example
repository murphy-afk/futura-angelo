# Copy this file to server/.env and fill in the real values.
# Never commit server/.env to the repository.

# MySQL connection, same credentials you use in MySQL Workbench
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=futura

# Express API port
SERVER_PORT=4000

# Client origin in development, used by CORS
CLIENT_ORIGIN=http://localhost:5173

# Public site URL, used for canonical links and meta tags
PUBLIC_URL=http://localhost:5173

# See the real client IP behind a reverse proxy, used by the lead rate limit.
# Keep false unless a proxy you control sits in front of the server.
# Accepted values: false, true, loopback, a hop count, an IP or CIDR list.
TRUST_PROXY=false
